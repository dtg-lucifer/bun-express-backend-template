{
	"name": "backend-template-expressjs",
	"version": "1.0.0",
	"description": "Express.js backend template with TypeScript, Bun, Biome and TypeSpec documentation",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts src/workers/index.ts --outdir=./dist --minify --sourcemap=external --target=bun",
		"start": "bun dist/index.js",
		"worker:dev": "bun run --watch src/workers/index.ts",
		"worker:start": "bun run src/workers/index.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"commitlint": "commitlint",
		"lint-staged": "lint-staged",
		"prepare": "lefthook install",
		"docs:generate": "bun run src/scripts/generate-openapi.ts",
		"db:migrate": "node-pg-migrate up --migrations-dir=src/shared/database/migrations",
		"db:migrate:down": "node-pg-migrate down --migrations-dir=src/shared/database/migrations",
		"db:migrate:new": "node-pg-migrate create --migration-file-language=sql --migrations-dir=src/shared/database/migrations"
	},
	"keywords": [],
	"author": "Piush Bose <mail@piush.in>",
	"license": "ISC",
	"packageManager": "bun@1.2.22",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@types/bun": "^1.3.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^25.9.1",
		"@types/pg": "^8.20.0",
		"@types/swagger-ui-express": "^4.1.8",
		"@typespec/compiler": "^1.12.0",
		"@typespec/http": "^1.12.0",
		"@typespec/openapi3": "^1.12.0",
		"biome": "^0.3.3",
		"lefthook": "^2.1.8",
		"lint-staged": "^17.0.5"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.5.0",
		"@scalar/express-api-reference": "^0.9.19",
		"bullmq": "^5.77.6",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"ioredis": "^5.11.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"node-pg-migrate": "^8.0.4",
		"pg": "^8.21.0",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^5.0.1",
		"uuid": "^14.0.0",
		"winston": "^3.19.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"private": true,
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
